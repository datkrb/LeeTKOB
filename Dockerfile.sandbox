FROM alpine:3.20

RUN apk add --no-cache g++ \
  && addgroup -g 10001 -S sandbox \
  && adduser -u 10001 -S -G sandbox -H -s /sbin/nologin sandbox \
  && mkdir -p /work \
  && chown 10001:10001 /work

COPY scripts/sandbox-run.sh /usr/local/bin/sandbox-run.sh
RUN chmod 0555 /usr/local/bin/sandbox-run.sh

WORKDIR /work
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/sandbox-run.sh"]
