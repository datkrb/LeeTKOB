{
  "name": "leetkob",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LeeTKOB (CSC13114 class project): the publish slice, its contract and the quality gate.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "contract": "node --test --test-reporter=spec \"test/contract/**/*.test.js\"",
    "e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run contract",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.3"
  }
}
