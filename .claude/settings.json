{
  "permissions": {
    "allow": [
      "Read",
      "Edit(src/**)",
      "Edit(test/**)",
      "Edit(e2e/**)",
      "Edit(public/**)",
      "Edit(docs/**)",
      "Bash(npm ci)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run contract)",
      "Bash(npm run e2e)",
      "Bash(npm start)",
      "Bash(npx prettier --write:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch -c:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git commit --amend:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "WebFetch",
      "Edit(.github/**)",
      "Edit(docs/contract/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(package.json)",
      "Edit(package-lock.json)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Edit(.env)",
      "Bash(cat .env:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
