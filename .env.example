# Copy to .env and fill in locally. .env is git-ignored; never commit a value.
# Names only here; never put real values in this file.

# HTTP port of the server (default 3007).
PORT=

# Path to SQLite database file (default data/leetkob.db; use :memory: for ephemeral).
DB_PATH=

# Model provider and model for the constraint checker (PA#3), e.g. gemini / gemini-2.5-flash.
LLM_PROVIDER=
LLM_MODEL=
# API key of a project with a spending cap: ours has no billing attached, cap 0 USD (README).
LLM_API_KEY=

# Wall-clock timeout per model call in milliseconds (default 15000).
LLM_TIMEOUT_MS=

# Optional per-1M-token USD pricing overrides for call-log cost estimation.
LLM_INPUT_USD_PER_1M=
LLM_OUTPUT_USD_PER_1M=

# The app's own cost cap per lab, in US dollars: it stops calling the model above this.
LLM_MAX_USD_PER_LAB=

# Set to 1 to disable model calls and run deterministic hard rules only (semantic -> unsure).
MODEL_OFF=

# Polling interval for the standalone judge worker in milliseconds (default 500).
WORKER_POLL_MS=

# Docker image name for the C++17 judging sandbox (default leetkob-sandbox).
SANDBOX_IMAGE=
