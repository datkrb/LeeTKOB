# Copy to .env and fill in locally. .env is git-ignored; never commit a value.
# Names only here. The app reads only PORT today; the LLM variables arrive in PA#3.

# HTTP port of the server (default 3007).
PORT=

# Model provider and model for the constraint checker (PA#3), e.g. gemini / gemini-2.5-flash.
LLM_PROVIDER=
LLM_MODEL=
# API key of a project with a spending cap: ours has no billing attached, cap 0 USD (README).
LLM_API_KEY=

# The app's own cost cap per lab, in US dollars: it stops calling the model above this.
LLM_MAX_USD_PER_LAB=
